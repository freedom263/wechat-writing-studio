# 生产环境配置示例
# 复制为 .env 并在其中填入实际参数

PROJECT_NAME=文思·微信公众号创作工作台
VERSION=1.0.0
API_V1_STR=/api/v1

# 数据库配置（挂载在 Docker Volume 卷中保持持久化）
DATABASE_URL=sqlite+aiosqlite:///./data/writing_studio.db

# 核心大模型配置
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEFAULT_MODEL=deepseek-chat
