# ==============================================================================
# 文思 · 微信公众号创作工作台 环境变量配置示例
# ==============================================================================

# DeepSeek 官方 API 配置 (开箱即用，兼容 OpenAI 规范)
# 申请地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEFAULT_MODEL=deepseek-chat

# 数据库存储 (自用默认 SQLite，无需安装任何数据库软件；商业化可切换为 PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./writing_studio.db

# 服务端配置
PORT=8000
HOST=0.0.0.0
